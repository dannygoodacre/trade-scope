{
  "name": "trade-scope",
  "private": true,
  "type": "module",
  "workspaces": [
    "./*"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,yellow\" \"npm run dev -w @trade-scope/frontend\" \"npm run dev -w @trade-scope/backend\"",
    "dev:frontend": "npm run dev -w @trade-tracker/frontend",
    "dev:backend": "npm run dev -w @trade-tracker/backend",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "concurrently": "10.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.66.0"
  }
}

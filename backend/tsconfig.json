{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@trade-tracker/shared": ["../shared/src/index.ts"],
      "@trade-tracker/shared/*": ["../shared/src/*"]
    },

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "../shared/src/**/*"
  ]
}
